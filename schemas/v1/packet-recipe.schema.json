{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasoning-bridge.dev/schemas/v1/packet-recipe.schema.json",
  "title": "PacketRecipe",
  "type": "object",
  "required": ["recipe_id", "slots"],
  "properties": {
    "recipe_id": {"type": "string", "minLength": 1},
    "priority": {"type": "integer"},
    "activation_goal": {"type": "string"},
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/PacketSlotSpec"}
    },
    "source_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/SourceBinding"}
    },
    "selection_signals": {"type": "array", "items": {"type": "string"}},
    "density_profile": {"enum": ["sparse", "balanced", "dense"]},
    "max_characters": {"type": "integer", "minimum": 0},
    "max_stereotype_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "anti_caricature_rules": {"type": "array", "items": {"type": "string"}},
    "render_profile": {"type": "string"},
    "description": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "PacketSlotSpec": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {
          "enum": [
            "frame",
            "identity",
            "constraints",
            "evidence",
            "examples",
            "open_vars",
            "anti_caricature"
          ]
        },
        "required": {"type": "boolean"},
        "max_characters": {"type": "integer", "minimum": 0},
        "fill_policy": {"enum": ["priority", "union", "override"]},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "SourceBinding": {
      "type": "object",
      "required": ["slot_role", "source"],
      "properties": {
        "slot_role": {
          "enum": [
            "frame",
            "identity",
            "constraints",
            "evidence",
            "examples",
            "open_vars",
            "anti_caricature"
          ]
        },
        "source": {"type": "string", "minLength": 1},
        "selector": {"type": "string"},
        "max_items": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
