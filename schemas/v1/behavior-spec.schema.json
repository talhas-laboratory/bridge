{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasoning-bridge.dev/schemas/v1/behavior-spec.schema.json",
  "title": "BehaviorSpec",
  "type": "object",
  "required": ["behavior_id", "priority"],
  "properties": {
    "behavior_id": {"type": "string", "minLength": 1},
    "priority": {"type": "integer"},
    "trigger_signals": {"type": "array", "items": {"type": "string"}},
    "routing_mode": {"enum": ["bias", "override"]},
    "preferred_route": {"type": "string"},
    "directives": {"type": "array", "items": {"type": "string"}},
    "operator_biases": {"type": "object", "additionalProperties": {"type": "boolean"}}
  },
  "additionalProperties": false
}
