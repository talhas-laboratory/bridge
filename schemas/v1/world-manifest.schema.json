{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasoning-bridge.dev/schemas/v1/world-manifest.schema.json",
  "title": "WorldManifest",
  "type": "object",
  "required": ["manifest_id", "lens_id"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1},
    "lens_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string"},
    "request_id": {"type": "string"},
    "constituents": {
      "type": "array",
      "items": {"$ref": "#/$defs/WorldConstituent"}
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "WorldConstituent": {
      "type": "object",
      "required": ["constituent_id", "kind", "label"],
      "properties": {
        "constituent_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "salience": {"type": "number"},
        "requires_definition": {"type": ["boolean", "null"]},
        "role_hint": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
